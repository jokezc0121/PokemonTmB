# Configuración del Entorno de Desarrollo y Producción
# Copia este archivo como .env dentro de la carpeta backend: cp .env.example .env

PORT=3000
NODE_ENV=development

# Conexión con Supabase (Base de Datos Postgres y Almacenamiento de Archivos)
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_tu_clave_secreta_aqui
SUPABASE_BUCKET=archivos

# Configuración de Autenticación JWT
JWT_SECRET=tu_clave_secreta_jwt_debe_ser_larga_y_segura_2026
JWT_EXPIRES_HOURS=12

# Configuración de CORS (orígenes permitidos separados por comas)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Cadena de conexión directa a PostgreSQL (para migraciones y scripts)
DATABASE_URL=postgresql://postgres:<tu-password>@db.<tu-proyecto>.supabase.co:5432/postgres
